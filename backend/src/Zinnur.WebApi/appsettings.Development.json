{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": { "Microsoft.AspNetCore": "Information" }
    }
  },

  // ---------------------------------------------------------------------
  // OBYEKT OMBORI — API'ni KONTEYNERSIZ (`dotnet run`) ishga tushirganda.
  //
  // Manzil host'ga chiqarilgan MinIO porti (docker-compose.yml dagi
  // `minio` xizmati: 9010 -> 9000).
  //
  // KONTEYNERDA BU QIYMATLAR KUCHGA KIRMAYDI: compose
  // `Storage__ServiceUrl=http://minio:9000` ni muhit o'zgaruvchisi bilan
  // beradi, muhit o'zgaruvchisi esa fayldan USTUN. Ya'ni ikkala holatda
  // ham to'g'ri manzil ishlatiladi va "mening mashinamda ishlaydi"
  // holati tug'ilmaydi.
  //
  // Kalitlar `.env` dagi STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY bilan
  // BIR XIL bo'lishi SHART — MinIO ildiz kaliti aynan o'sha. Mos kelmasa
  // ombor 403 `SignatureDoesNotMatch` beradi va sabab hech qayerda
  // ko'rinmaydi.
  //
  // ⚠️ INTEGRATSIYA TESTLARI bu bo'limni ATAYLAB bo'shatadi
  // (`ZinnurApiFactory`): ular "ombor sozlanmagan -> 503" holatini ham
  // tekshiradi, ya'ni ombor holatini TEST boshqarishi kerak, bu fayl emas.
  // ---------------------------------------------------------------------
  "Storage": {
    "ServiceUrl": "http://localhost:9010",
    "Bucket": "zinnur-dev",
    "AccessKey": "zinnur_dev_minio",
    "SecretKey": "zinnur_dev_minio_secret",
    "Region": "us-east-1",
    "KeyPrefix": "submissions",
    "TimeoutSeconds": 60
  }
}
