{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "App": {
    "TimeZone": "Asia/Tashkent"
  },
  "ConnectionStrings": {
    "Postgres": "Host=postgres;Port=5432;Database=zinnur;Username=zinnur;Password=zinnur",
    "Redis": "redis:6379"
  },
  "Jwt": {
    "Issuer": "zinnur",
    "Audience": "zinnur-web",
    "Secret": "CHANGE_ME_min_32_bytes_secret_key_here_0123456789",
    "AccessMinutes": 15,
    "RefreshDays": 7
  },
  "LiveKit": {
    "Url": "ws://livekit:7880",
    "ApiKey": "devkey",
    "ApiSecret": "CHANGE_ME_livekit_secret_min_32_chars_0123456789"
  },
  "Storage": {
    "ServiceUrl": "",
    "Bucket": "",
    "AccessKey": "",
    "SecretKey": "",
    "Region": "auto",
    "KeyPrefix": "submissions",
    "TimeoutSeconds": 60
  },
  "Payments": {
    "EnforceBlock": true,
    "DefaultBlockThreshold": 540000,
    "DefaultBlockScope": "Video"
  },
  "Telegram": {
    "BotToken": "",
    "WebhookSecret": "",
    "MiniAppUrl": "",
    "BotUsername": "",
    "ApiBaseUrl": "https://api.telegram.org",
    "TimeoutSeconds": 15,
    "InitDataMaxAgeHours": 24
  },
  "Jobs": {
    "Enabled": true,
    "TickSeconds": 30,
    "SessionAutoClose": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "GraceMinutes": 60,
      "BatchSize": 100
    },
    "MonthlyBilling": {
      "Enabled": true,
      "IntervalMinutes": 30
    }
  },
  "Notifications": {
    "Enabled": true,
    "BatchSize": 50,
    "PollSeconds": 5,
    "LeaseSeconds": 120,
    "RateLimit": {
      "PerSecond": 25,
      "Burst": 30
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "AllowedHosts": "*"
}
