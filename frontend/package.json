{
  "name": "zinnur-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vite build && vite build --ssr src/entry-ssg.ts --outDir dist-ssg && node scripts/prerender.mjs",
    "preview": "vite preview",
    "seo:ping": "node scripts/indexnow.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@microsoft/signalr": "8.0.17",
    "@sentry/vue": "^10.69.0",
    "@tanstack/vue-query": "5.101.4",
    "livekit-client": "2.21.0",
    "pinia": "3.0.4",
    "vue": "3.5.40",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/eslint-config-typescript": "14.9.0",
    "eslint": "9.39.5",
    "eslint-plugin-vue": "9.33.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.6.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vue-tsc": "2.2.12"
  }
}
