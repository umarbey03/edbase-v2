# Zin-Nur frontend — build-time muhit o'zgaruvchilari (SPEC 8-bo'lim).
# Bu qiymatlar Vite tomonidan build paytida kodga "qotib" yoziladi.

# REST API'ning ildiz manzili (oxirida `/` bo'lmasin). Yo'llar: <VITE_API_URL>/api/v1/...
VITE_API_URL=http://localhost:5080

# SignalR hub to'liq manzili (SPEC: hub yo'li `/hubs/live`).
VITE_HUB_URL=http://localhost:5080/hubs/live
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_RELEASE=dev

# Telegram botining foydalanuvchi nomi (`@` siz). IXTIYORIY.
# Berilsa: landing sahifadagi «Telegram bot» havolasi va Mini App'dagi
# "botga qaytish" tugmasi shu nomdan `t.me/<nom>` yasaydi.
# Berilmasa: havola UMUMAN chizilmaydi (buzuq havoladan yaxshiroq).
#
# ⚠️ KIRISH OQIMIGA TA'SIR QILMAYDI: «Telegram orqali kirish» tugmasi
#    havolani SERVERDAN oladi (`telegram.bot_username` sozlamasi).
VITE_TELEGRAM_BOT_USERNAME=
