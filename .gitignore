# ---- SIRLAR (eng muhim) ----
# .env ichida DB paroli, JWT maxfiy kaliti, LiveKit siri bor.
# .env.example esa NAMUNA — u git'da bo'lishi KERAK.
.env
.env.*
!.env.example

# ---- .NET ----
bin/
obj/
*.user
*.suo
[Dd]ebug/
[Rr]elease/
TestResults/
*.trx
*.coverage
coverage*.json
coverage*.xml
.vs/

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-error.log*
.eslintcache

# ---- Vaqtinchalik / OS ----
.DS_Store
Thumbs.db
*.swp
*.bak
*.tmp
migration.sql

# ---- IDE ----
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# ---- Ma'lumot / zaxira ----
backups/
*.dump
*.sql.gz

# Baza dumplari (qo'lda olingan zaxira) — repoga TUSHMASIN.
.backups/

# Prerender oraliq bundle`i (scripts/prerender.mjs uni o`chiradi, lekin
# build yarim yo`lda uzilsa qolib ketishi mumkin).
dist-ssg

# ---- Deploy paytida yasaladigan fayllar ----
# `infra/livekit/livekit.prod.yaml` — SHABLON (git'da).
# `deploy.sh` undan `__LIVEKIT_API_KEY__` ni `.env` dagi qiymatga
# almashtirib quyidagi faylni yasaydi va konteynerga AYNAN o'sha ulanadi.
# U git'ga TUSHMASLIGI kerak: ichida `.env` dan olingan kalit bor.
infra/livekit/livekit.prod.generated.yaml
