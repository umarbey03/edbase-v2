# =============================================================================
#  ZIN-NUR v2 — MUHIT O'ZGARUVCHILARI (namuna)
# =============================================================================
#
#  ISHLATISH:
#      cp .env.example .env
#      # keyin pastdagi "O'ZGARTIRING" deb belgilangan qiymatlarni almashtiring
#
#  MUHIM:
#    * `.env` fayli GIT'ga TUSHMAYDI (.gitignore + .dockerignore da).
#    * Docker Compose shu fayldan ${...} qiymatlarini o'qiydi (interpolatsiya),
#      shu bilan birga `api` va `web` konteynerlariga `env_file:` orqali uzatadi.
#    * SPEC 8-bo'limdagi `__` uslubidagi .NET kalitlari (ConnectionStrings__Postgres
#      va h.k.) bu yerda EMAS — ular docker-compose.yml ning `environment:`
#      blokida QO'LDA yig'iladi. Sabab: parolni bir joyda saqlab, uni bir nechta
#      joyga (connection string, healthcheck, initdb) tarqatish oson bo'lsin.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. UMUMIY
# -----------------------------------------------------------------------------
# .NET muhiti: Development => batafsil xato sahifasi + Swagger.
# PROD'da MAJBURIY: Production
ASPNETCORE_ENVIRONMENT=Development

# Konteynerlar ichidagi vaqt zonasi. Loglar UTC'da yozilsa ham, jadval
# ko'rsatkichlari uchun mahalliy zona qulay. Baza esa doim UTC saqlaydi (SPEC 9.6).
TZ=Asia/Tashkent


# -----------------------------------------------------------------------------
# 2. POSTGRESQL
# -----------------------------------------------------------------------------
# Bu uchtasi ikki joyda ishlatiladi:
#   a) postgres konteynerini birinchi marta initsializatsiya qilishda
#   b) api uchun ConnectionStrings__Postgres ni yig'ishda
# Shuning uchun ular bitta manbadan (shu fayldan) olinadi — mos kelmay qolish
# muammosi (eng ko'p uchraydigan "password authentication failed" xatosi) yo'q.
POSTGRES_DB=zinnur
POSTGRES_USER=zinnur
# O'ZGARTIRING (prod). Yaratish: openssl rand -base64 24
POSTGRES_PASSWORD=zinnur_dev_only_change_me

# Npgsql ulanishlar hovuzi (pool) chegarasi.
# NEGA MUHIM (200 foydalanuvchi): 200 ta foydalanuvchi != 200 ta DB ulanishi.
# Har HTTP so'rov ulanishni bir necha millisekundga oladi va qaytaradi.
# 50 ta ulanish 200 foydalanuvchi uchun juda yetarli; postgres tomonda
# max_connections=200 qo'yilgan, ya'ni api'ning bir nechta nusxasi (instance)
# ko'tarilsa ham zaxira bor. Bu sonni oshirish odatda YOMONLASHTIRADI —
# postgres har ulanishga alohida process ochadi.
POSTGRES_MAX_POOL_SIZE=50


# -----------------------------------------------------------------------------
# 3. REDIS
# -----------------------------------------------------------------------------
# Redis uchta vazifani bajaradi (SPEC 4 va 6-bo'limlar):
#   1) SignalR backplane  — api'ning bir nechta nusxasi o'zaro xabar almashadi
#   2) IPresenceService   — jonli darsdagi ishtirokchilar ro'yxati
#   3) chat rate-limit hisoblagichi (1 xabar / 2 sek)
# Shuning uchun Redis o'chsa — dars buziladi. AOF (appendonly) yoqilgan.
#
# Dev'da parol yo'q: redis faqat `zinnur-net` ichki tarmog'ida va host'da
# 6390 portida (localhost) turadi. Prod'da host'ga UMUMAN chiqarilmaydi.
# Agar bu serverda boshqa (ishonchsiz) konteynerlar ham bo'lsa —
# docker-compose.prod.yml dagi "REDIS PAROLI" izohli blokini yoqing.
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# 4. JWT (o'z tizimimizning tokenlari — LiveKit tokeni EMAS)
# -----------------------------------------------------------------------------
JWT_ISSUER=zinnur
JWT_AUDIENCE=zinnur-web

# O'ZGARTIRING. Kamida 32 bayt (HS256 uchun). Yaratish:
#     openssl rand -base64 48
# NEGA 32+: qisqa kalit brute-force'ga ochiq; .NET ham 256-bitdan kichik
# kalitni rad etadi (IDX10653).
JWT_SECRET=dev_only_zinnur_jwt_secret_change_me_min_32_bytes_long

# Access token qisqa (15 daq) — o'g'irlansa ham tez o'ladi.
JWT_ACCESS_MINUTES=15
# Refresh token uzoq (14 kun) — foydalanuvchi har kuni login qilmasin.
# Bekor qilish: User.TokenVersion oshiriladi (SPEC 3-bo'lim).
JWT_REFRESH_DAYS=7


# -----------------------------------------------------------------------------
# 5. LIVEKIT
# -----------------------------------------------------------------------------
# API_KEY va API_SECRET **ikkala tomonda bir xil** bo'lishi SHART:
#   * api      -> LiveKit__ApiKey / LiveKit__ApiSecret (token IMZOLAYDI)
#   * livekit  -> LIVEKIT_KEYS="<key>: <secret>"       (token TEKSHIRADI)
# Mos kelmasa: brauzer "invalid token" olib, xonaga kira olmaydi.
LIVEKIT_API_KEY=devkey

# O'ZGARTIRING. LiveKit sirni KAMIDA 32 belgi talab qiladi. Yaratish:
#     openssl rand -hex 32
LIVEKIT_API_SECRET=dev_only_livekit_secret_change_me_min_32_chars_ok

# ---- LiveKit__PublicUrl — DIQQAT, eng nozik joy -------------------------
# Bu qiymat api'dan LiveKitJoinDto.ServerUrl sifatida **BRAUZERGA** qaytadi.
# Ya'ni u brauzer hal qila oladigan manzil bo'lishi kerak.
# `ws://livekit:7880` — bu Docker ichki DNS nomi, brauzer uni BILMAYDI.
# Dev'da to'g'ri qiymat: ws://localhost:7880 (compose 7880 portini host'ga chiqargan).
# Prod'da: wss://livekit.<domeningiz>   (host nginx TLS terminatsiya qiladi)
LIVEKIT_PUBLIC_URL=ws://localhost:7880

# Server-server chaqiruvlar (xona yaratish/o'chirish, egress boshqaruvi) uchun
# ICHKI manzil. Brauzerga hech qachon berilmaydi, TLS shart emas, tashqi
# tarmoqqa chiqmaydi — tezroq va xavfsizroq.
LIVEKIT_INTERNAL_URL=http://livekit:7880


# -----------------------------------------------------------------------------
# 6. CORS
# -----------------------------------------------------------------------------
# .NET massivlari `__0`, `__1` ... ko'rinishida beriladi (SPEC 8-bo'lim).
# Dev: Vite konteyneri 5173 portida.
CORS_ORIGIN_0=http://localhost:5173
# Ikkinchi manba kerak bo'lsa (masalan `npm run dev` host'da 5174 portda):
# docker-compose.yml dagi `Cors__AllowedOrigins__1` qatorini yoqing.
CORS_ORIGIN_1=http://localhost:5174


# -----------------------------------------------------------------------------
# 6b. NAMUNAVIY (DEMO) MA'LUMOT
# -----------------------------------------------------------------------------
# `true` — BO'SH bazaga to'liq namunaviy o'quv markazi yoziladi (xodimlar,
# 12 o'quvchi, guruhlar, darslar, davomat, baholar, to'lovlar, chat, yozuvlar).
# Yangi serverni QO'LDA tekshirish uchun mo'ljallangan.
#
# Kirish raqamlari jadvali API loglarida chiqadi:
#   docker compose logs api | grep -A 25 "Namunaviy hisoblar"
#
# Kirish kodi soxta Telegram ID'ga yuboriladi, ya'ni telefonga KELMAYDI —
# uni bazadan o'qing:
#   docker compose exec -T postgres psql -U zinnur -d zinnur -c \
#     "SELECT \"Body\" FROM \"MessageOutbox\" WHERE \"TemplateKey\"='auth_login_code' \
#      ORDER BY \"Id\" DESC LIMIT 1;"
#
# 🔴 ISHLAB CHIQARISHDA `false` BO'LSIN. Yoqilgan holda ham ikkinchi himoya
# ishlaydi: bazada 3 tadan ko'p foydalanuvchi bo'lsa seeder ISHLAMAYDI va
# logga xato yozadi. Ya'ni ishlayotgan markazga soxta o'quvchi tusha olmaydi.
SEED_DEMO=false


# -----------------------------------------------------------------------------
# 7. FRONTEND (BUILD-TIME!)
# -----------------------------------------------------------------------------
# DIQQAT: Vite o'zgaruvchilari `npm run build` PAYTIDA JS faylga "quyiladi".
# Konteyner ishga tushgach ularni o'zgartirib bo'lmaydi — image'ni QAYTA
# yig'ish kerak:  docker compose build web
# Shuning uchun compose'da ular `environment:` emas, `build.args:` orqali beriladi.
VITE_API_URL=http://localhost:5080
VITE_HUB_URL=http://localhost:5080/hubs/live


# -----------------------------------------------------------------------------
# 8. OBYEKT OMBORI — vazifa fayllari (rasm / ovoz)
# -----------------------------------------------------------------------------
# DEV: MinIO konteyneri (docker-compose.yml dagi `minio` xizmati).
# PROD: Cloudflare R2 — pastdagi 9-bo'limdagi `R2_*` qiymatlari ishlatiladi
#       va docker-compose.prod.yml bu bo'limni QAYTA yozadi.
#
# ⚠️ "TO'LIQ yoki BO'SH" QOIDASI: ServiceUrl, Bucket, AccessKey, SecretKey —
# to'rttasi ham to'ldirilishi yoki to'rttasi ham bo'sh bo'lishi kerak. Yarim
# to'ldirilgan bo'lsa ilova ATAYLAB ko'tarilmaydi (`ValidateOnStart`), aks
# holda xato faqat birinchi yuklashda — haqiqiy o'quvchi javob
# topshirayotganda — chiqardi.
#
# Bo'sh qoldirilsa: ilova ODATDAGIDEK ishlaydi, faqat fayl yuklash 503
# qaytaradi (matnli javob topshirish ishlayveradi). LOKAL DISKKA HECH QACHON
# yozilmaydi — eski tizim shunday qilgani uchun fayllar bitta konteynerga
# bog'lanib qolgan va deploy'da yo'qolgan edi.

# ICHKI docker DNS nomi. Host'dagi 9010 porti EMAS: api konteyner ichidan
# `localhost:9010` ga chiqa olmaydi, SigV4 imzosi esa HOST bilan bog'liq.
# (Brauzer bu manzilni umuman ko'rmaydi — fayl api orqali uzatiladi.)
STORAGE_SERVICE_URL=http://minio:9000

STORAGE_BUCKET=zinnur-dev

# MinIO ildiz kaliti ham, api'ning S3 kaliti ham SHU IKKALASI (bitta manba).
# MinIO parolni kamida 8 belgi talab qiladi.
# O'ZGARTIRING (prod'da bu qatorlar umuman ishlatilmaydi — R2_* ishlatiladi).
STORAGE_ACCESS_KEY=zinnur_dev_minio
STORAGE_SECRET_KEY=zinnur_dev_minio_secret

# MinIO ning standart regioni — `us-east-1`. R2 uchun esa `auto`.
# Region imzoga KIRADI: noto'g'ri bo'lsa ombor 403 `SignatureDoesNotMatch`
# beradi va sabab hech qayerda ko'rinmaydi.
STORAGE_REGION=us-east-1

# Bitta bucket'ni modullar bo'yicha ajratish uchun kalit prefiksi.
STORAGE_KEY_PREFIX=submissions

# BRAUZER ko'radigan ombor manzili — `STORAGE_SERVICE_URL` dan ALOHIDA.
# Dars yozuvi presigned havola bilan beriladi va uni brauzer ochadi;
# ichki `minio:9000` nomi brauzerda yechilmaydi.
# ⚠️ Xostni keyin qo'lda almashtirib bo'lmaydi — SigV4 imzosi `host`
# sarlavhasini qamrab oladi, o'zgartirilsa ombor 403 beradi.
# Prod'da: https://media.zinnur.uz (yoki R2 ommaviy domeni)
STORAGE_PUBLIC_URL=http://localhost:9010


# =============================================================================
# 8b. TELEGRAM (FAZA 5.1) — o'quvchilar uchun YAGONA kirish yo'li
# =============================================================================
# Dev'da BO'SH qoldirish MUMKIN va odatiy: u holda webhook 404 qaytaradi,
# Mini App kirishi 503 beradi, xabarlar navbatdan logga tushadi. Ilova
# odatdagidek ishlayveradi — xodimlar email+parol bilan kiraveradi.
#
# ⚠️ BOT_TOKEN va WEBHOOK_SECRET — JUFT. Bittasi to'ldirilib ikkinchisi bo'sh
# qolsa ilova ATAYLAB ko'tarilmaydi. Sabab: sirsiz webhook internetga OCHIQ
# qolardi va har kim soxta "yangilanish" yuborib bot nomidan ish qildira
# olardi. Yarim sozlangan holatni ishga tushirishdan ko'ra darhol yiqilgan
# afzal — aks holda teshik jimgina ochiq turardi.

# @BotFather bergan token.
TELEGRAM_BOT_TOKEN=
# O'ZINGIZ o'ylab topasiz (faqat A-Za-z0-9_- , 256 belgigacha) va aynan shuni
# `setWebhook` ning `secret_token` parametrida Telegram'ga berasiz. Telegram
# uni har so'rovda `X-Telegram-Bot-Api-Secret-Token` sarlavhasida qaytaradi.
# Yaratish: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Mini App ochiladigan manzil — **https majburiy** (Telegram talabi).
TELEGRAM_MINI_APP_URL=
# Bot foydalanuvchi nomi (@siz) — frontend havolasi uchun.
TELEGRAM_BOT_USERNAME=

# Xabar yuborish tezligi. Telegram global chegarasi 30/sekund; 25 ataylab
# pastroq — chegaraga tegib 429 olgandan ko'ra sal sekin yuborgan afzal.
NOTIFY_RATE_PER_SECOND=25


# =============================================================================
# 9. FAQAT PROD UCHUN (docker-compose.prod.yml o'qiydi)
# =============================================================================
# Asosiy domen — host nginx (infra/nginx/zinnur.conf) shu nom bilan ishlaydi.
DOMAIN=zinnur.uz
# LiveKit sub-domeni. DNS'da A-yozuvi shu serverning oq IP'siga qaratilsin.
LIVEKIT_DOMAIN=livekit.zinnur.uz

# Serverning TASHQI (oq) IP manzili.
# NEGA KERAK: LiveKit ICE nomzodlarida shu IP'ni e'lon qiladi. Odatda
# `use_external_ip: true` uni avtomatik topadi, lekin ba'zi hosting'larda
# (bir nechta interfeys, GRE tunnel) noto'g'ri topadi. Shunda shu yerga
# qo'lda yozing va livekit.yaml dagi `external_ip` qatorini yoqing.
# Bo'sh qoldirilsa — avtomatik aniqlash ishlatiladi.
SERVER_PUBLIC_IP=

# ---- PROD OBYEKT OMBORI: Cloudflare R2 ------------------------------------
# docker-compose.prod.yml SHU qiymatlarni `Storage__*` ga qo'yadi va shu
# bilan yuqoridagi DEV MinIO qiymatlarini QAYTA YOZADI.
#
# NEGA ALOHIDA NOM (`R2_*`, `STORAGE_*` emas): compose overlay'lari
# `environment` ni BIRLASHTIRADI — bir xil nom ishlatilsa dev qiymati
# prod'da jimgina qolib ketardi. Bu loyihada aynan shunday bug bir marta
# bo'lgan (dev LiveKit sozlamalari prod'ga o'tib ketgan edi).
#
# Bo'sh qoldirilsa: prod'da fayl yuklash 503 qaytaradi — ya'ni MinIO
# emas, OCHIQ XATO. Bu ataylab: jimgina noto'g'ri ombor ishlatilgandan
# ko'ra ko'rinadigan nosozlik yaxshi.
#
# O'ZGARTIRING (prod):
#   R2_SERVICE_URL=https://<account-id>.r2.cloudflarestorage.com
R2_SERVICE_URL=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# R2 uchun DOIM `auto` (u regionsiz ishlaydi). AWS S3 bo'lsa — haqiqiy region.
R2_REGION=auto
R2_KEY_PREFIX=submissions
